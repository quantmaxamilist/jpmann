---
import Arrow from '../site/Arrow.astro';
import { home, about } from '../../data/site';
---
<section class="ab">
  <div class="container ab__grid">
    <p class="label ab__label" data-reveal>{home.aboutLabel}</p>
    <p class="ab__statement display" data-reveal>{home.aboutStatement}</p>
    <div class="ab__body" data-reveal style="--d:.08">
      <p>{home.about1}</p>
      <p>{home.about2}</p>
      <a class="btn btn--navy" href="/about">{home.aboutCta} <Arrow /></a>
    </div>
    <aside class="ab__card" data-reveal style="--d:.14">
      <img src="/img/logos/ice.png" alt="Institution of Civil Engineers" width="200" height="156" loading="lazy" />
      <p class="label">{about.founderRole}</p>
      <ul role="list">
        {about.education.concat(about.membership).map((e) => <li>{e}</li>)}
      </ul>
    </aside>
  </div>
</section>
<style>
  .ab { padding-block: var(--section); background: var(--paper); }
  .ab__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr); grid-template-areas: 'label label label' 'st body card'; gap: var(--s-3) var(--s-5); align-items: start; }
  .ab__label { grid-area: label; color: var(--teal); }
  .ab__statement { grid-area: st; font-size: var(--fs-display-3); line-height: 1.08; color: var(--navy); }
  .ab__body { grid-area: body; display: grid; gap: var(--s-3); justify-items: start; color: var(--ink-2); }
  .ab__card { grid-area: card; background: var(--white); border: 1px solid var(--line-light); padding: var(--s-4); border-radius: var(--radius); display: grid; gap: var(--s-2); }
  .ab__card img { width: 120px; }
  .ab__card .label { color: var(--teal); }
  .ab__card ul { margin: 0; padding: 0; display: grid; gap: 0.5rem; font-size: var(--fs-small); }
  .ab__card li { padding-left: 1rem; position: relative; }
  .ab__card li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 6px; height: 6px; background: var(--teal); }
  @media (max-width: 1100px) { .ab__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: 'label label' 'st st' 'body card'; } }
  @media (max-width: 700px) { .ab__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'label' 'st' 'body' 'card'; } }
</style>
