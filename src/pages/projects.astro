---
import Base from '../layouts/Base.astro';
import PageHero from '../components/site/PageHero.astro';
import CtaBand from '../components/site/CtaBand.astro';
import { pages, projects, featured, small, srcsetFor } from '../data/site';
const p = pages['projects-8'];
---
<Base title={p.title} description={p.description} image="/img/projects/swindon-digesters.jpg">
  <PageHero kicker="Featured foundation and structural projects" title="Projects Gallery" lead="Every project has its own DNA" img="/img/projects/swindon-digesters.jpg" crumbs={[{ href: '/projects', label: 'Projects' }]} />
  <section class="pg">
    <div class="container">
      {projects.map((pr, i) => (
        <article class:list={['pg__item', { 'pg__item--flip': i % 2 }]} id={pr.slug}>
          <figure class="pg__img" data-reveal>
            <img class="grade" src={pr.img} srcset={srcsetFor(pr.img, pr.w)} sizes="(max-width: 860px) 100vw, 50vw" alt={pr.title} width={pr.w} height={pr.h} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          </figure>
          <div class="pg__txt" data-reveal style="--d:.08">
            <p class="label pg__n">{String(i + 1).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</p>
            <h2 class="pg__h">{pr.title}</h2>
            <div class="pg__body">
              {pr.body.map((t) => /^✔️?\s*/u.test(t) && t.startsWith('✔') ? <p class="pg__tick">{t.replace(/^✔️?\s*/u, '')}</p> : <p>{t.replace(/[\u{1F300}-\u{1FAFF}]/gu, '').trim()}</p>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="pf dark">
    <div class="container">
      <h2 class="display pf__h">Featured foundation and structural projects</h2>
      <div class="pf__grid">
        {featured.map((f) => (
          <figure data-reveal>
            <div class="pf__img"><img class="grade" src={small(f.img)} alt={f.name} width={f.w} height={f.h} loading="lazy" decoding="async" /></div>
            <figcaption class="label">{f.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .pg { padding-block: var(--section); background: var(--paper); }
  .pg__item { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .pg__item + .pg__item { margin-top: var(--section); }
  .pg__item--flip .pg__img { order: 2; }
  .pg__img { border-radius: var(--radius); overflow: hidden; background: var(--paper-2); max-height: 640px; }
  .pg__img img { width: 100%; height: 100%; max-height: 640px; object-fit: cover; }
  .pg__n { color: var(--teal); }
  .pg__h { margin-top: var(--s-2); font-family: var(--font-display); font-weight: 800; font-stretch: 108%; font-size: var(--fs-display-3); line-height: 1.08; color: var(--navy); overflow-wrap: anywhere; }
  .pg__body { margin-top: var(--s-3); display: grid; gap: 0.8rem; color: var(--ink-2); max-width: 62ch; }
  .pg__tick { padding-left: 1.6rem; position: relative; color: var(--navy); font-weight: 600; }
  .pg__tick::before { content: ''; position: absolute; left: 0; top: 0.3em; width: 14px; height: 8px; border-left: 2.5px solid var(--teal); border-bottom: 2.5px solid var(--teal); transform: rotate(-45deg); }
  .pf { padding-block: var(--section); }
  .pf__h { font-size: var(--fs-display-3); max-width: 20ch; margin-bottom: var(--s-5); }
  .pf__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .pf__grid figure { display: grid; gap: 0.75rem; }
  .pf__img { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius); }
  .pf__img img { width: 100%; height: 100%; object-fit: cover; }
  .pf__grid figcaption { color: rgba(255, 255, 255, 0.75); }
  @media (max-width: 860px) {
    .pg__item { grid-template-columns: minmax(0, 1fr); }
    .pg__item--flip .pg__img { order: 0; }
    .pf__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
