---
import Arrow from '../site/Arrow.astro';
import { home, featured, projects, small } from '../../data/site';
const spot = ['swindon-digesters', 'bengaluru', 'football-club'].map((s) => projects.find((p) => p.slug === s)!);
---
<section class="pj">
  <div class="container">
    <div class="pj__head">
      <h2 class="display pj__h" data-reveal>{home.projectsH}</h2>
      <p class="pj__sub" data-reveal style="--d:.08">{home.projectsSub}</p>
    </div>
    <div class="pj__feat">
      {featured.map((f, i) => (
        <figure class={`pj__f pj__f--${i}`} data-reveal style={`--d:${i * 0.08}`}>
          <div class="pj__img"><img class="grade" src={small(f.img)} alt={f.name} width={f.w} height={f.h} loading="lazy" decoding="async" /></div>
          <figcaption class="label">{f.name}</figcaption>
        </figure>
      ))}
      <a class="pj__next" href="/contact" data-reveal style="--d:.24">
        <span class="display">{home.projectsNext}</span>
        <span class="btn btn--light">Get a free quote <Arrow /></span>
      </a>
    </div>
    <div class="pj__spots">
      {spot.map((p, i) => (
        <a class="pj__spot" href={`/projects#${p.slug}`} data-reveal style={`--d:${i * 0.08}`}>
          <div class="pj__img pj__img--sq"><img class="grade" src={small(p.img)} alt={p.title} width={p.w} height={p.h} loading="lazy" decoding="async" /></div>
          <h3>{p.title}</h3>
          <p class="muted">{p.body[0]}</p>
        </a>
      ))}
    </div>
    <a class="btn btn--navy pj__all" href="/projects">{home.projectsCta} <Arrow /></a>
  </div>
</section>
<style>
  .pj { padding-block: var(--section); background: var(--white); }
  .pj__head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s-4); align-items: end; padding-bottom: var(--s-4); border-bottom: 1px solid var(--line-light); margin-bottom: var(--s-5); }
  .pj__h { font-size: var(--fs-display-2); color: var(--navy); max-width: 15ch; }
  .pj__sub { font-family: var(--font-display); font-size: var(--fs-statement); font-weight: 500; color: var(--teal); justify-self: end; }
  .pj__feat { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s-3); }
  .pj__f { display: grid; gap: 0.75rem; align-content: start; }
  .pj__f figcaption { color: var(--ink-2); }
  .pj__f--0 { grid-column: 1 / span 4; grid-row: span 2; }
  .pj__f--0 .pj__img { aspect-ratio: 3 / 4; }
  .pj__f--1 { grid-column: 5 / span 4; }
  .pj__f--2 { grid-column: 9 / span 4; }
  .pj__f--1 .pj__img, .pj__f--2 .pj__img { aspect-ratio: 4 / 3; }
  .pj__next { grid-column: 5 / span 8; display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); flex-wrap: wrap; padding: var(--s-4); background: var(--teal); color: var(--white); text-decoration: none; border-radius: var(--radius); }
  .pj__next .display { font-size: var(--fs-display-3); }
  .pj__img { overflow: hidden; background: var(--paper-2); border-radius: var(--radius); }
  .pj__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  a:hover .pj__img img, .pj__f:hover img { transform: scale(1.04); }
  .pj__spots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); margin-top: var(--s-6); }
  .pj__spot { text-decoration: none; display: grid; gap: 0.75rem; align-content: start; }
  .pj__img--sq { aspect-ratio: 4 / 3; }
  .pj__spot h3 { font-family: var(--font-display); font-weight: 750; font-stretch: 106%; font-size: 1.25rem; line-height: 1.2; color: var(--navy); }
  .pj__spot p { font-size: var(--fs-small); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pj__all { margin-top: var(--s-5); }
  @media (max-width: 900px) {
    .pj__head { grid-template-columns: minmax(0, 1fr); }
    .pj__sub { justify-self: start; }
    .pj__feat { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .pj__f--0 { grid-column: 1 / -1; grid-row: auto; }
    .pj__f--0 .pj__img { aspect-ratio: 4 / 3; }
    .pj__f--1, .pj__f--2 { grid-column: auto; }
    .pj__next { grid-column: 1 / -1; }
    .pj__spots { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) { .pj__feat { grid-template-columns: minmax(0, 1fr); } }
</style>
