---
import Mark from './Mark.astro';
const { class: cls = '' } = Astro.props;
---
<a href="/" class:list={['logo', cls]} aria-label="JPMANN — home">
  <Mark class="logo__mark" />
  <span class="logo__word">JPMANN</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--white); }
  .logo__mark { width: 34px; height: auto; color: var(--teal-hi); flex: none; }
  .logo__word { font-family: var(--font-text); font-weight: 400; font-size: 1.375rem; letter-spacing: 0.32em; line-height: 1; margin-right: -0.32em; }
  @media (max-width: 400px) { .logo { gap: 0.45rem; } .logo__mark { width: 28px; } .logo__word { font-size: 1.0625rem; letter-spacing: 0.22em; margin-right: -0.22em; } }
</style>
