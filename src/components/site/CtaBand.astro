---
import Arrow from './Arrow.astro';
import { contact } from '../../data/site';
const { href = '/contact', heading = 'Get a free quote for your project' } = Astro.props;
---
<section class="cta">
  <div class="container cta__in">
    <p class="display cta__h">{heading}</p>
    <div class="cta__acts">
      <a class="btn btn--light" href={href}>Send an enquiry <Arrow /></a>
      <a class="cta__phone" href={contact.phoneHref}>{contact.phone}</a>
      <a class="cta__mail link-line" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--teal); color: var(--white); padding-block: clamp(3rem, 6vw, 5rem); }
  .cta__in { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
  .cta__h { font-size: var(--fs-display-3); max-width: 18ch; }
  .cta__acts { display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .cta__phone { font-family: var(--font-display); font-weight: 750; font-size: 1.5rem; text-decoration: none; }
  .cta__mail { text-decoration: none; }
</style>
