---
// Signature moment: a cut-away of the ground assembles itself — strata, borehole, retaining wall,
// stone columns, piles, pile cap and the JP Mann "A" as the structure — then a 1–6 list arrives.
import Arrow from '../site/Arrow.astro';
import { home, services, serviceSummary, pages } from '../../data/site';

const parts = [
  { key: 'frame', service: 'structural-engineering' },
  { key: 'cap', service: 'geotechnical-foundation-design' },
  { key: 'piles', service: 'pile-design' },
  { key: 'columns', service: 'ground-improvement' },
  { key: 'wall', service: 'geotechnical-engineering' },
  { key: 'borehole', service: '' },
].map((p, i) => {
  const n = String(i + 1).padStart(2, '0');
  if (!p.service) {
    // Site investigation has its own old page (kept at /site-investigation) rather than a service slot.
    const si = pages['site-investigation'];
    const first = si.blocks.find((b) => b.t === 'p')!.x;
    return { ...p, n, name: si.blocks[0].x, href: '/site-investigation', summary: (first.match(/^.+?[.!?](\s|$)/)?.[0] ?? first).trim() };
  }
  const s = services.find((x) => x.slug === p.service)!;
  return { ...p, n, name: s.name, href: `/services/${s.slug}`, summary: serviceSummary(s) };
});
---
<section class="wow dark" id="services" data-wow>
  <div class="container wow__head">
    <h2 class="display wow__h" data-reveal>{home.servicesH}</h2>
    <p class="wow__sub muted" data-reveal style="--d:.08">{home.servicesSub}</p>
  </div>
  <div class="container wow__grid">
    <div class="wow__stage" data-wow-stage>
      <img class="wow__poster" src="/img/wow-poster.jpg" alt="Cut-away of the ground: strata, a borehole, a retaining wall, stone columns, piles, a pile cap and the JP Mann A as the structure." width="1600" height="1200" loading="lazy" decoding="async" />
      <canvas class="wow__canvas" data-wow-canvas aria-hidden="true"></canvas>
      <div class="wow__pins" data-wow-pins aria-hidden="true">
        {parts.map((p) => <span class="wow__pin" data-pin={p.key}></span>)}
      </div>
      <button class="wow__replay label" type="button" data-wow-replay hidden>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8a5 5 0 1 0 1.5-3.6M3 2v3h3" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
        Replay
      </button>
    </div>
    <ol class="wow__list" role="list" data-wow-list>
      {parts.map((p, i) => (
        <li style={`--i:${i}`}>
          <a href={p.href} data-part={p.key}>
            <span class="wow__n label">{p.n}</span>
            <span class="wow__name">{p.name}</span>
            <span class="wow__sum">{p.summary}</span>
            <span class="wow__go"><Arrow /></span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="container wow__more">
    <a class="btn btn--ghost" href="/services">All services <Arrow /></a>
    <a class="btn" href="/contact">Get a free quote for your project <Arrow /></a>
  </div>
</section>

<script>
  import { initWow } from '../../scripts/wow-ground.js';
  initWow(document.querySelector('[data-wow]'));
</script>

<style>
  .wow { padding-block: var(--section); background: radial-gradient(120% 80% at 30% 60%, var(--navy-3) 0%, var(--navy) 60%); overflow: hidden; }
  .wow__head { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s-4); align-items: end; margin-bottom: var(--s-5); }
  .wow__h { font-size: var(--fs-display-2); max-width: 16ch; }
  .wow__sub { font-size: var(--fs-statement); font-family: var(--font-display); font-weight: 500; line-height: 1.25; max-width: 20ch; justify-self: end; }
  .wow__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: var(--s-5); align-items: center; }
  .wow__stage { position: relative; aspect-ratio: 4 / 3; }
  .wow__poster, .wow__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wow__poster { object-fit: contain; }
  .wow__canvas { opacity: 0; transition: opacity 0.3s; }
  .wow.is-live .wow__canvas { opacity: 1; }
  .wow.is-live .wow__poster { visibility: hidden; }
  .wow__pins { position: absolute; inset: 0; pointer-events: none; }
  .wow__pin { position: absolute; top: 0; left: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 4px rgba(63, 176, 210, 0.35); opacity: 0; transition: opacity 0.4s, transform 0.3s var(--ease-out), background 0.2s; pointer-events: auto; cursor: pointer; }
  .wow.is-done .wow__pin { opacity: 1; }
  .wow__pin.is-on { background: var(--teal-hi); transform: scale(1.5); box-shadow: 0 0 0 6px rgba(63, 176, 210, 0.3); }
  .wow__replay { position: absolute; right: 0; bottom: 0; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 40px; padding: 0 0.9rem; background: rgba(255, 255, 255, 0.06); border: 1px solid var(--line-dark); border-radius: var(--radius); cursor: pointer; color: var(--white); }
  .wow__replay svg { width: 14px; height: 14px; }
  .wow__replay:hover { background: rgba(255, 255, 255, 0.12); }

  .wow__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line-dark); }
  /* The list's box never changes size: it only fades in once the model has assembled. */
  .wow.is-live .wow__list li { opacity: 0; transform: translateY(10px); transition: opacity 0.45s var(--ease-out), transform 0.55s var(--ease-out); transition-delay: calc(var(--i) * 0.06s); }
  .wow.is-live.is-done .wow__list li { opacity: 1; transform: none; }
  .wow__list a { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr) 24px; column-gap: var(--s-2); padding: 1.05rem 0; text-decoration: none; border-bottom: 1px solid var(--line-dark); transition: background 0.2s; }
  .wow__n { color: var(--teal-hi); padding-top: 0.35rem; }
  .wow__name { font-family: var(--font-display); font-weight: 750; font-stretch: 108%; font-size: clamp(1.125rem, 0.95rem + 0.5vw, 1.4375rem); line-height: 1.2; }
  .wow__sum { grid-column: 2; font-size: var(--fs-small); color: rgba(255, 255, 255, 0.66); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 0.3rem; }
  .wow__go { grid-column: 3; grid-row: 1; align-self: center; color: var(--teal-hi); opacity: 0.5; transition: transform var(--dur) var(--ease-out), opacity 0.2s; }
  .wow__go :global(svg) { width: 18px; }
  .wow__list a:hover .wow__go, .wow__list a.is-on .wow__go { opacity: 1; transform: translateX(4px); }
  .wow__list a.is-on .wow__name, .wow__list a:hover .wow__name { color: var(--teal-hi); }
  .wow__more { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-5); }

  @media (max-width: 1000px) {
    .wow__head { grid-template-columns: minmax(0, 1fr); }
    .wow__sub { justify-self: start; }
    .wow__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  }
  @media (max-width: 560px) {
    .wow__more .btn { width: 100%; justify-content: center; }
    .wow__sum { display: none; }
  }
</style>
