---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/site/PageHero.astro';
import Article from '../../components/site/Article.astro';
import CtaBand from '../../components/site/CtaBand.astro';
import { posts, fmtDate } from '../../data/site';
import fs from 'node:fs';
export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const url = `https://www.jpmann.com/post/${post.slug}`;
const img0 = fs.existsSync(`public/img/blog/${post.slug}.jpg`) ? `/img/blog/${post.slug}.jpg` : undefined;
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.h1, description: post.description, datePublished: post.published, dateModified: post.modified, mainEntityOfPage: { '@type': 'WebPage', '@id': url }, url, ...(img0 ? { image: 'https://www.jpmann.com' + img0 } : {}), author: { '@type': 'Organization', name: 'JPMANN', url: 'https://www.jpmann.com' }, publisher: { '@type': 'Organization', name: 'JPMANN', logo: { '@type': 'ImageObject', url: 'https://www.jpmann.com/favicon.svg' } } };
const img = fs.existsSync(`public/img/blog/${post.slug}.jpg`) ? `/img/blog/${post.slug}.jpg` : undefined;
---
<Base title={post.title} description={post.description} image={img} schema={[ld]}>
  <PageHero kicker={`Blog · ${fmtDate(post.published)}`} title={post.h1} crumbs={[{ href: '/blog', label: 'Blog' }]} />
  <Article blocks={post.blocks} img={img} />
  <CtaBand />
</Base>
