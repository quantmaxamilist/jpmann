---
import Arrow from '../site/Arrow.astro';
import { home, contact } from '../../data/site';
---
<section class="hero dark" data-hero>
  <div class="hero__media">
    <img class="hero__img grade" src="/img/site-piling-aerial.jpg" srcset="/img/hero-800.jpg 800w, /img/hero-1400.jpg 1400w, /img/site-piling-aerial.jpg 2400w" sizes="100vw" alt="A construction site with heavy machinery." width="2400" height="1349" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <!-- Intro: the logo mark is a window onto the photo, then opens to full screen (≈1.6s, skippable) -->
  <svg class="hero__veil" viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-veil>
    <path fill="#001e30" fill-rule="evenodd" d="M-4000-4000H5000V5000H-4000Z M500 400 618.6 595.4H554.2L500 503.2 446.2 595.4H381.4Z" />
  </svg>

  <div class="hero__in container">
    <h1 class="hero__h1">
      <span class="hero__kicker" data-hero-line>{home.h1a}</span>
      <span class="hero__big display" data-hero-line>{home.h1b}</span>
    </h1>
    <p class="hero__h2" data-hero-line>{home.h2}</p>
    <p class="hero__intro" data-hero-line>{home.intro}</p>
    <div class="hero__ctas" data-hero-line>
      <a class="btn" href="/contact">{home.cta} <Arrow /></a>
      <a class="btn btn--ghost" href={contact.phoneHref}>Call {contact.phone}</a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  const hero = document.querySelector('[data-hero]');
  const veil = hero?.querySelector('[data-veil]') as SVGElement | null;
  const lines = hero ? [...hero.querySelectorAll('[data-hero-line]')] : [];
  const img = hero?.querySelector('.hero__img');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const arriving = document.documentElement.classList.contains('pt-arrive');
  if (hero && veil) {
    if (reduced || arriving) {
      veil.remove();
    } else {
      // Scale about a point inside the A's left leg so the leg grows to fill the screen.
      const shape = veil.querySelector('path')!;
      hero.classList.add('is-intro');
      gsap.set(lines, { y: 24 });
      const tl = gsap.timeline({ onComplete: () => veil.remove() })
        .from(img!, { scale: 1.18, duration: 2.2, ease: 'power3.out' }, 0)
        .fromTo(shape, { scale: 1 }, { scale: 60, svgOrigin: '444 545', duration: 1.15, ease: 'expo.in' }, 0.35)
        .to(veil, { opacity: 0, duration: 0.25 }, 1.25)
        .to(lines, { y: 0, duration: 0.7, ease: 'expo.out', stagger: 0.07 }, 1.15);
      const skip = () => { tl.progress(1); off(); };
      const off = () => ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) => removeEventListener(ev, skip));
      ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach((ev) => addEventListener(ev, skip, { once: true, passive: true }));
      tl.eventCallback('onComplete', () => { veil.remove(); hero.classList.remove('is-intro'); off(); });
      // Never let the intro hang: whatever happens, the hero is fully shown after 3s.
      setTimeout(() => { if (tl.progress() < 1) tl.progress(1); }, 3000);
    }
  }
</script>

<style>
  .hero { position: relative; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; padding-top: calc(var(--header-h) + var(--s-5)); padding-bottom: clamp(2.5rem, 6vh, 5rem); }
  .hero__media { position: absolute; inset: 0; z-index: -3; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 50%; }
  .hero__shade { position: absolute; inset: 0; z-index: -2; background:
    linear-gradient(90deg, rgba(0, 30, 48, 0.94) 0%, rgba(0, 30, 48, 0.78) 38%, rgba(0, 30, 48, 0.2) 75%),
    linear-gradient(0deg, rgba(0, 30, 48, 0.85) 0%, rgba(0, 30, 48, 0) 45%); }
  .hero__veil { display: none; }
  .hero.is-intro .hero__veil { display: block; position: absolute; inset: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; will-change: transform; }
  .hero__in { position: relative; }
  .hero__h1 { display: grid; gap: 0.6rem; max-width: 15ch; font-weight: inherit; }
  .hero__kicker { font-family: var(--font-mono); font-size: clamp(0.8125rem, 0.7rem + 0.35vw, 1rem); letter-spacing: 0.12em; text-transform: uppercase; color: var(--teal-hi); font-weight: 500; max-width: none; }
  .hero__big { font-size: var(--fs-hero); max-width: 13ch; }
  .hero__h2 { margin-top: var(--s-3); font-family: var(--font-display); font-weight: 600; font-stretch: 105%; font-size: var(--fs-statement); line-height: 1.2; color: var(--white); max-width: 26ch; }
  .hero__intro { margin-top: var(--s-3); max-width: 62ch; color: rgba(255, 255, 255, 0.8); font-size: var(--fs-small); line-height: 1.65; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-4); }
  @media (max-width: 640px) {
    .hero__shade { background: linear-gradient(0deg, rgba(0, 30, 48, 0.96) 0%, rgba(0, 30, 48, 0.88) 55%, rgba(0, 30, 48, 0.45) 100%); }
    .hero__ctas .btn { width: 100%; justify-content: center; }
  }
</style>
