---
import { home, clients } from '../../data/site';
const { h = home.clientsH, sub = home.clientsSub, tag = 'h2' } = Astro.props;
const H = tag;
---
<section class="cl">
  <div class="container">
    <H class="display cl__h" data-reveal>{h}</H>
    <p class="cl__sub muted" data-reveal style="--d:.06">{sub}</p>
    <ul class="cl__logos" role="list">
      {clients.logos.map((l, i) => (
        <li class:list={['cl__logo', { 'cl__logo--dark': l.dark }]} data-reveal style={`--d:${i * 0.05}`}>
          <img src={l.src} alt={l.alt} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
    <ul class="cl__names label" role="list">
      {clients.named.map((n) => <li>{n}</li>)}
    </ul>
  </div>
</section>
<style>
  .cl { padding-block: var(--section); background: var(--paper); }
  .cl__h { font-size: var(--fs-display-3); color: var(--navy); max-width: 22ch; }
  .cl__sub { margin-top: var(--s-2); max-width: 56ch; font-size: var(--fs-lead); }
  .cl__logos { margin: var(--s-5) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--s-2); }
  .cl__logo { aspect-ratio: 3 / 2; display: grid; place-items: center; background: var(--white); border: 1px solid var(--line-light); border-radius: var(--radius); padding: 1.25rem; }
  .cl__logo--dark { background: #000; }
  .cl__logo { min-height: 0; overflow: hidden; }
  .cl__logo img { width: 100%; height: 100%; object-fit: contain; }
  .cl__names { margin: var(--s-3) 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; color: var(--teal); }
  @media (max-width: 900px) { .cl__logos { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .cl__logos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
