---
// Sticky side card on inner pages: the enquiry route and the phone are always one glance away.
import Arrow from './Arrow.astro';
import { contact, services } from '../../data/site';
const { current = '', href = '/contact' } = Astro.props;
---
<aside class="as">
  <div class="as__card">
    <p class="label as__label">Get a free quote</p>
    <a class="btn as__btn" href={href}>Send an enquiry <Arrow /></a>
    <a class="as__phone" href={contact.phoneHref}>{contact.phone}</a>
    <a class="as__mail link-line" href={`mailto:${contact.email}`}>{contact.email}</a>
  </div>
  <nav class="as__nav" aria-label="Services">
    <p class="label as__label">Services</p>
    <ul role="list">
      {services.map((s) => <li><a href={`/services/${s.slug}`} aria-current={s.slug === current ? 'page' : undefined}>{s.name}</a></li>)}
    </ul>
  </nav>
</aside>
<style>
  .as { position: sticky; top: calc(var(--header-h) + 1.5rem); display: grid; gap: var(--s-3); align-self: start; }
  .as__card { background: var(--navy); color: var(--white); padding: var(--s-4) var(--s-3); border-radius: var(--radius); display: grid; gap: var(--s-2); }
  .as__label { color: var(--teal-hi); }
  .as__btn { justify-content: space-between; }
  .as__phone { font-family: var(--font-display); font-weight: 750; font-size: 1.375rem; text-decoration: none; }
  .as__mail { text-decoration: none; font-size: var(--fs-small); justify-self: start; }
  .as__nav .as__label { color: var(--teal); margin-bottom: 0.5rem; }
  .as__nav ul { margin: 0; padding: 0; border-top: 1px solid var(--line-light); }
  .as__nav a { display: block; padding: 0.6rem 0; border-bottom: 1px solid var(--line-light); text-decoration: none; font-size: var(--fs-small); color: var(--ink-2); transition: color 0.2s, padding 0.3s var(--ease-out); }
  .as__nav a:hover, .as__nav a[aria-current] { color: var(--teal); padding-left: 0.4rem; }
  .as__nav a[aria-current] { font-weight: 600; }
  @media (max-width: 960px) { .as { position: static; } .as__nav { display: none; } }
</style>
